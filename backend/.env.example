# Copy this file to .env and fill in the real key. .env is gitignored —
# never commit the real key.
#
# Get a free-tier key at https://aistudio.google.com/apikey
#
# The Gemini key lives only on the backend (plan.md §9) — it is never sent
# to or read by the frontend/browser.

GEMINI_API_KEY=your-key-here
