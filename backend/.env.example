# Copy this file to .env and fill in the real key. .env is gitignored —
# never commit the real key.
#
# ONLY NEEDED FOR RECOGNIZER=remote (or =both). As of step 3r.6e the
# default recognizer is "cnn", which runs entirely on this machine and
# makes no API call at all — a normal run needs no key here.
#
# Get a free-tier key at https://aistudio.google.com/apikey
#
# The Gemini key lives only on the backend (plan.md §9) — it is never sent
# to or read by the frontend/browser.

GEMINI_API_KEY=your-key-here

# Which recognition path to use (plan.md §16). Unset means "cnn".
#   cnn    — local CNN, no network, no cost, no rate limit (default)
#   remote — Tesseract for the ID + Gemini for serial/marks; needs the key above
#   both   — runs both, returns the CNN's result, logs disagreements to
#            comparison_log/; spends real Gemini quota, for comparison runs only
# RECOGNIZER=cnn
