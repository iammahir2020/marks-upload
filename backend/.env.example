# Copy this file to .env and fill in the real key. .env is gitignored —
# never commit the real key.
#
# ONLY NEEDED FOR RECOGNIZER=remote (or =both). As of step 3r.6e the
# default recognizer is "cnn", which runs entirely on this machine and
# makes no API call at all — a normal run needs no key here.
#
# Get a free-tier key at https://aistudio.google.com/apikey
#
# The Gemini key lives only on the backend (plan.md §9) — it is never sent
# to or read by the frontend/browser.

GEMINI_API_KEY=your-key-here

# Which recognition path to use (plan.md §16). Unset means "cnn".
#   cnn    — local CNN, no network, no cost, no rate limit (default)
#   remote — Tesseract for the ID + Gemini for serial/marks; needs the key above
#   both   — runs both, returns the CNN's result, logs disagreements to
#            comparison_log/; spends real Gemini quota, for comparison runs only
# RECOGNIZER=cnn

# --- Step 11.1: deployment seams -------------------------------------------
# Every one of these is optional. UNSET REPRODUCES THE LAPTOP APP EXACTLY —
# that property is asserted by tests/test_config.py, not just intended.

# Comma-separated CORS allowlist for a hosted frontend. Unset keeps the
# localhost + private-LAN regex, which rejects a public domain outright.
# ALLOWED_ORIGINS=https://marks.example.com

# Where harvested training crops go: "local" (default) or "s3".
# HARVEST_BACKEND=local

# Local destination. Default: backend/training_data/harvested
# HARVEST_DIR=/some/other/path

# S3 destination. HARVEST_BUCKET is required when HARVEST_BACKEND=s3;
# the app refuses to build a store without it rather than silently
# dropping crops. Credentials come from the usual AWS chain (on Lambda,
# the execution role) — never put keys in this file.
# HARVEST_BUCKET=my-marks-crops
# HARVEST_PREFIX=harvested

# Kill switch: set false and /api/harvest becomes a no-op that still
# answers 200, since the frontend fires it unawaited and must never see a
# harvest failure as a save failure.
# HARVEST_ENABLED=true

# --- Step 11.4: public-URL hardening ---------------------------------------
# There is no auth and deliberately won't be for a demo — these stand in.

# Largest accepted upload. Real captures measured 166 KB average / 807 KB
# largest, so the 4 MB default is generous by a wide margin.
#
# 4 MB and not 5: Lambda's 6 MB request limit applies to the BASE64-ENCODED
# payload, not the raw bytes, and base64 inflates by 4/3. A 5 MB image
# becomes a 6.7 MB payload and is rejected by the platform with an opaque
# error — exactly what this cap exists to prevent. 4 MB raw is ~5.3 MB
# encoded, leaving room for the multipart envelope.
# MAX_UPLOAD_BYTES=4194304

# Per-IP request budget. 30/min is ~10x a real instructor's ~3/min, and
# survives several faculty behind one institutional NAT. See
# app/ratelimit.py for what an in-memory limiter is honestly worth on
# Lambda (per container instance, not global).
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS=30
# RATE_LIMIT_WINDOW_SECONDS=60
