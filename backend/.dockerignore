# Step 11.3's "How": without this the build context carries gigabytes it
# will never use. Measured in this repo: venv/ 1.5 GB, cnn/data/ 2.2 GB
# (the EMNIST download), training_data/ 14 MB.

venv/
__pycache__/
*.pyc
.pytest_cache/

# The EMNIST download — regenerated by cnn/train.py, never needed at
# inference.
cnn/data/

# Training checkpoints. digit_cnn.onnx is the deliverable and IS copied in
# (step 11.3.2); the .pt files it was exported from are not.
cnn/checkpoints/*.pt

# Collected crops. These are the thing step 11.2 moves OFF the app host —
# baking them into the image would be the same mistake in a new place.
training_data/

# Local-only state, none of it meaningful in a container.
certs/
debug/
debug_uploads/
comparison_log/
.env

# Test and harness code. The image runs the app; the suite runs in CI or on
# a laptop, against the source tree.
tests/
*.md
