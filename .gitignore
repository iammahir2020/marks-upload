# Python
venv/
.venv/
__pycache__/
*.py[cod]

# Node
node_modules/
dist/
dev-dist/

# Secrets
.env
.env.local

# Detection harness output — regenerated on every run
debug/

# Dev-only self-signed certs — regenerated per machine (gen_dev_cert.py)
certs/

# TEMPORARY step 6 debugging only — real phone captures saved for
# inspection since the backend is otherwise stateless. Remove this and the
# save code in app/main.py once step 6 is confirmed working.
debug_uploads/

# Claude Code setup (solo project)
.claude/

# Optional CNN track (step.md steps 2r.0/2r/3r/3r.6, plan.md §16) —
# EMNIST download (~2GB, regenerated by cnn/train.py's own
# torchvision.datasets.EMNIST(download=True) call) and training run
# artifacts. The final digit_cnn.onnx (~150KB) is the actual deliverable
# once a step's Done-when bar is met — not ignored, so it can be committed
# deliberately when that happens.
backend/cnn/data/
backend/cnn/checkpoints/*.pt
backend/cnn/preview/
backend/cnn/*.log

# step 3r.6d — RECOGNIZER=both's disagreement log (real handwriting-
# derived data, only produced during an actual comparison run) and
# step 3r.6c's harvested training crops (real student/instructor
# handwriting) — neither belongs in git, same reasoning as debug_uploads/.
comparison_log/
backend/training_data/harvested/

# synthetic_scripts/ — downloaded font files (redistributable, but no need
# to carry the bytes in the repo; synthetic_scripts/generate.py documents
# exactly which 15 Google Fonts + Liberation Sans to fetch) and the
# generator's own output dir, kept separate from the reviewed original
# images/ on purpose (see CLAUDE.md / step.md step 0).
synthetic_scripts/fonts/
synthetic_scripts/generated/
synthetic_scripts/_recs/
