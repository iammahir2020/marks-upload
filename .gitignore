# Python
venv/
.venv/
__pycache__/
*.py[cod]

# Node
node_modules/
dist/
dev-dist/

# Secrets
.env
.env.local

# Detection harness output — regenerated on every run
debug/

# Dev-only self-signed certs — regenerated per machine (gen_dev_cert.py)
certs/

# Kept as a tripwire, not because anything writes here. main.py's
# debug_uploads/ block — which saved every upload to disk during step 6 —
# was DELETED in step 11.0.1, along with the 605 real scripts / 99 MB it
# had accumulated. The rule stays so that if anyone ever reintroduces that
# pattern, the output is ignored rather than committed.
debug_uploads/

# Claude Code setup (solo project)
.claude/

# Optional CNN track (step.md steps 2r.0/2r/3r/3r.6, plan.md §16) —
# EMNIST download (~2GB, regenerated by cnn/train.py's own
# torchvision.datasets.EMNIST(download=True) call) and training run
# artifacts. The final digit_cnn.onnx (~150KB) is the actual deliverable
# once a step's Done-when bar is met — not ignored, so it can be committed
# deliberately when that happens.
backend/cnn/data/
backend/cnn/checkpoints/*.pt
backend/cnn/preview/
backend/cnn/*.log

# step 3r.6d — RECOGNIZER=both's disagreement log (real handwriting-
# derived data, only produced during an actual comparison run) and
# step 3r.6c's harvested training crops (real student/instructor
# handwriting) — neither belongs in git, same reasoning as debug_uploads/.
comparison_log/
backend/training_data/harvested/
# fetch-crops.sh's merged training set — regenerable from the sources above
# plus S3, and it is student handwriting either way.
backend/training_data/all/

# synthetic_scripts/ — downloaded font files (redistributable, but no need
# to carry the bytes in the repo; synthetic_scripts/generate.py documents
# exactly which 15 Google Fonts + Liberation Sans to fetch) and the
# generator's own output dir, kept separate from the reviewed original
# images/ on purpose (see CLAUDE.md / step.md step 0).
synthetic_scripts/fonts/
synthetic_scripts/generated/
synthetic_scripts/_recs/
frontend/.preflight-dist/

# Editor and OS noise. These lived only in frontend/.gitignore, so they were
# ignored under frontend/ and nowhere else (issues.md N27).
.vscode/
.idea/
.DS_Store
.pytest_cache/

# Session OUTPUT — the files a real class produces, as opposed to the ones
# the backend writes (harvested/ and comparison_log/ above). An exported
# workbook is every student's ID, serial and marks in one file, and the
# Results screen explicitly tells the instructor to check it against their
# attendance sheet — which is how it ends up sitting in this tree.
# Ignored BEFORE the pilot runs, because afterwards the fix stops being a
# .gitignore edit and becomes a history rewrite (issues.md N26).
*.xlsx
collection_sheet*.docx
# ...but the grid template itself is a real, tracked deliverable.
!marks-grid-template.docx

# Generated by substituting the real account id into aws/deploy-policy.json.
# Not secret, but account-specific — regenerate rather than commit.
aws/deploy-policy.generated.json
